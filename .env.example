# Appium / Android
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=Pixel 7
ANDROID_UDID=emulator-5554
ANDROID_PLATFORM_VERSION=13
MY_MOLDCELL_PACKAGE=md.moldcell.selfservice
MY_MOLDCELL_ACTIVITY=.screens.splash.SplashActivity

# Keep real values only in environment variables or a local .env file.
# Do not commit .env.
MY_MOLDCELL_USERNAME_MOBILE=
MY_MOLDCELL_USERNAME_EMAIL=
MY_MOLDCELL_PASSWORD=

# The default mode expects the application to be installed already.
# Set true only after configuring a signed-in Play Store emulator.
INSTALL_FROM_PLAY_STORE=false
